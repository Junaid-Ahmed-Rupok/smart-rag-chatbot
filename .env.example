# Free key from https://console.groq.com/keys . Without it the app runs in offline mode
# (it shows the best matching passages instead of writing answers).
GROQ_API_KEY=

# Optional
# LLM_PROVIDER=groq              # groq | ollama | offline
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=mistral
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # use paraphrase-multilingual-MiniLM-L12-v2 for Bengali and other languages
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# RETRIEVAL_K=5
# MAX_FILE_MB=25
# MAX_FILES=10
