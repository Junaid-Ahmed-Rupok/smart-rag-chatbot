# ── LLM provider ─────────────────────────────────────────────────────────────
# "groq"   = hosted API, no local install — users just `pip install` and run.
# "ollama" = fully local/offline, requires Ollama installed and running.
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# ── Embeddings (always local, regardless of LLM_PROVIDER) ────────────────────
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Ollama (only used when LLM_PROVIDER=ollama) ───────────────────────────────
DEFAULT_MODEL=mistral
OLLAMA_HOST=http://localhost:11434

# ── Model sampling ───────────────────────────────────────────────────────────
TEMPERATURE=0.2

# ── RAG ──────────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=change-me-before-deploy

# Set to True ONLY for local demos on your own laptop. Uses a fixed
# session id so closing/reopening the app always finds the same
# persisted documents. NEVER set this on a shared/public deployment —
# it removes per-user isolation between visitors.
LOCAL_DEMO_MODE=False
